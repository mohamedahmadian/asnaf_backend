DATABASE_URL="postgresql://asnaf_admin:PASSWORD@127.0.0.1:5432/asnaf?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3000

# Shared file storage with the portal API (same absolute FILE_STORAGE_DIR on both services).
FILE_STORAGE_DIR="D:/Main projects/qeshm/storage"

# Public addresses; the bank posts back to PUBLIC_API_URL and users land on PUBLIC_APP_URL
PUBLIC_API_URL="https://asnaf.example.ir/api"
PUBLIC_APP_URL="https://asnaf.example.ir"

# Behpardakht Mellat gateway (server IP must be registered with the bank)
MELLAT_TERMINAL_ID=""
MELLAT_USERNAME=""
MELLAT_PASSWORD=""
# MELLAT_SERVICE_URL="https://bpm.shaparak.ir/pgwchannel/services/pgw"
# MELLAT_START_PAY_URL="https://bpm.shaparak.ir/pgwchannel/startpay.mellat"

# Online payment link lifetime (hours)
PAYMENT_LINK_TTL_HOURS=48
