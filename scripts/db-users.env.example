# Copy to scripts/db-users.env (gitignored) or export these before running:
#   ./scripts/create-db-users.sh --env local
#   ./scripts/create-db-users.sh --env server

# Superuser used only to create the app roles (not for the APIs).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=asnaf
PGUSER=postgres
PGPASSWORD=password

# App roles. On --env server both passwords are required (min 16 chars).
# Values are read literally; $ and ! in the password stay as-is.
ASNAF_ADMIN_USER=asnaf_admin
ASNAF_ADMIN_PASSWORD=change-me-admin-password
ASNAF_PORTAL_USER=asnaf_portal
ASNAF_PORTAL_PASSWORD=change-me-portal-password
